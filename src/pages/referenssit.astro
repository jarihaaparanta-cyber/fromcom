---
import Sivupohja from '../layouts/Sivupohja.astro';
import SivuHero from '../components/SivuHero.astro';
import Galleria from '../components/Galleria.astro';
import Tarjous from '../components/Tarjous.astro';
import sininen from '../assets/kuvat/Galleria_sininen.webp';
import putket from '../assets/kuvat/FromCom_4.webp';
import novatron from '../assets/kuvat/IMG-20220524-WA0005.webp';
import ranta from '../assets/kuvat/IMG_20220711_221224963_HDR.webp';
import tyomaa from '../assets/kuvat/FromCom_2.webp';
import piha from '../assets/kuvat/valmis1-1.webp';
import perustus from '../assets/kuvat/IMG-20210724-WA0005.webp';
import kaivu from '../assets/kuvat/FromCom_1.webp';
import raivaus from '../assets/kuvat/IMG_20220818_181338203.webp';
import purku from '../assets/kuvat/Purku5.webp';
import tiivistys from '../assets/kuvat/IMG_20220428_174220470.jpg';
import kobelco from '../assets/kuvat/Fromcom_hero.webp';

// Kuvatekstit FromComin nykyisen sivuston kuvatietojen mukaan.
// TÄYDENNETÄÄN: referenssikohteiden tarkemmat kuvaukset (paikkakunta, työn sisältö, vuosi) asiakkaalta.
const kuvat = [
  { kuva: sininen, alt: 'FromComin turkoosi kaivinkone kaivaa kaivantoa lumisella työmaalla', otsikko: 'Kaivinkone kaivutyössä' },
  { kuva: putket, alt: 'Putket ja sorapohja hirsisaunan vieressä', otsikko: 'Putket ja sorapohja' },
  { kuva: novatron, alt: 'Novatron-koneohjauksen näyttö kaivinkoneen ohjaamossa', otsikko: 'Novatronin 3D-koneohjaus' },
  { kuva: ranta, alt: 'Rakennuksen perustukset rantamaisemassa', otsikko: 'Rakennusten perustustyöt' },
  { kuva: tyomaa, alt: 'Maanrakennustyömaa, kaivinkone ja järvimaisema', otsikko: 'Maanrakennustyöt rantakohteessa' },
  { kuva: piha, alt: 'Valmis nurmipiha ja rakennukset metsäisessä ympäristössä', otsikko: 'Piha- ja viherrakentaminen' },
  { kuva: perustus, alt: 'Rakennuksen perustukset ja sorapohja', otsikko: 'Perustukset ja sorapohja' },
  { kuva: tiivistys, alt: 'Oranssi kaivinkone ja työntekijä tärylevyn kanssa rakennuksen sorapohjalla', otsikko: 'Sorapohjan tiivistys tärylevyllä' },
  { kuva: kaivu, alt: 'Kaivinkone tasoittaa soraa rakennuksen pohjalla', otsikko: 'Rakennuksen pohjatyöt' },
  { kuva: raivaus, alt: 'Kaivinkone tien tasoitustyössä metsäisessä ympäristössä', otsikko: 'Tienpohjan tasaus' },
  { kuva: purku, alt: 'Purkutöiden puutavaraa ja kone työmaalla', otsikko: 'Rakennuksen purku' },
  { kuva: kobelco, alt: 'Turkoosi kaivinkone kuormaa maa-ainesta pihalla', otsikko: 'Maa-aineksen kuormaus pihatyömaalla' },
];
---
<Sivupohja otsikko="Referenssit" kuvaus="Kuvia FromCom Oy:n työmailta: perustustyöt, vesi- ja viemärityöt, pihat, raivaukset ja purkutyöt Pirkanmaalla.">
  <SivuHero
    kuva={ranta}
    kuvaAlt="Rakennuksen perustukset rantamaisemassa"
    otsikko="Referenssit"
    ingressi="Koneita, työmaita ja toteutuksia FromComin omista kohteista eri puolilta Pirkanmaata."
    murupolku={[{ nimi: 'Referenssit' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Kuvia työmailta</h2>
      </div>
      <Galleria kuvat={kuvat} />
    </div>
  </section>

  <Tarjous otsikko="Seuraava kohde voi olla sinun" />
</Sivupohja>

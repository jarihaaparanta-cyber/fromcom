---
import { Image } from 'astro:assets';
import Sivupohja from '../../layouts/Sivupohja.astro';
import SivuHero from '../../components/SivuHero.astro';
import Tarjous from '../../components/Tarjous.astro';
import Ikoni from '../../components/Ikoni.astro';
import { palvelut } from '../../data/sivusto.js';
import hero from '../../assets/kuvat/Galleria_sininen.webp';
---
<Sivupohja otsikko="Palvelut" kuvaus="FromCom Oy:n maanrakennuspalvelut Pirkanmaalla: perustustyöt, kunnallistekniikka, vesi- ja viemärityöt, piha- ja viherrakentaminen, tonttien raivaukset ja purkutyöt.">
  <SivuHero
    kuva={hero}
    kuvaAlt="FromComin turkoosi kaivinkone metsäisellä maanrakennustyömaalla"
    otsikko="Maanrakennuksen kaikki vaiheet."
    ingressi="Monipuoliset maanrakennuspalvelut rakentamisen eri vaiheisiin. Yksityisille ja yrityksille, koko Pirkanmaan alueella."
    murupolku={[{ nimi: 'Palvelut' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Maanrakennuspalvelut</h2>
      </div>
      <ul class="gallery">
        {palvelut.map((p) => (
          <li>
            <a class="tile" href={`/palvelut/${p.slug}/`}>
              <Image src={p.kuva} alt={p.kuvaAlt} widths={[480, 800]} sizes="(max-width: 520px) 100vw, (max-width: 900px) 50vw, 33vw" loading="lazy" />
              <span class="tile-caption"><strong>{p.nimi}</strong><span>Tutustu palveluun <Ikoni nimi="nuoli" koko={14} /></span></span>
            </a>
          </li>
        ))}
      </ul>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="wrap split is-top">
      <div class="section-head" style="margin:0">
        <h2>Tarkasti kerralla oikein.</h2>
      </div>
      <div class="prose">
        <p>Hyödynnämme töissämme Novatron 3D-koneohjausta. Se tukee suunnitelmien mukaista toteutusta ja auttaa vähentämään turhaa kaivamista.</p>
        <p>Kun korot ja kaltevuudet osuvat kohdalleen jo ensimmäisellä kerralla, työ etenee tehokkaasti ja sovitussa aikataulussa.</p>
        <a class="button button-outline" href="/kalusto/">Tutustu kalustoon <Ikoni nimi="nuoli" /></a>
      </div>
    </div>
  </section>

  <Tarjous />
</Sivupohja>

---
import Sivupohja from '../layouts/Sivupohja.astro';
import SivuHero from '../components/SivuHero.astro';
import Ikoni from '../components/Ikoni.astro';
import { yritys, yhteyshenkilot, TARJOUS_URL } from '../data/sivusto.js';
---
<Sivupohja otsikko="Yhteystiedot" kuvaus="Ota yhteyttä FromCom Oy:hyn: Arto From 050 550 3515, Väinö From 0400 170 169. Lohiranta 6, 36270 Kangasala.">
  <SivuHero
    kompakti
    otsikko="Ota yhteyttä"
    ingressi="Kerro kohteestasi ja työn tarpeista. Katsotaan yhdessä sopiva toteutus."
    murupolku={[{ nimi: 'Yhteystiedot' }]}
  />

  <section class="section">
    <div class="wrap">
      <div class="people">
        {yhteyshenkilot.map((h) => (
          <div class="person">
            <h3>{h.nimi}</h3>
            <a href={`tel:${h.tel}`}><Ikoni nimi="puhelin" />{h.puhelin}</a>
            <a href={`mailto:${h.email}`}><Ikoni nimi="posti" />{h.email}</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tint">
    <div class="wrap contact-grid">
      <div class="prose">
        <h2>Pyydä tarjous</h2>
        <p>Tarjouslomake kysyy kohteesta ja työstä kaiken olennaisen. Täyttäminen vie noin minuutin.</p>
        <div class="buttons">
          <a class="button button-amber" href={TARJOUS_URL}>Täytä tarjouspyyntö <Ikoni nimi="nuoli" /></a>
          <a class="button button-dark" href={`tel:${yhteyshenkilot[0].tel}`}>Soita {yhteyshenkilot[0].puhelin} <Ikoni nimi="puhelin" /></a>
        </div>
      </div>
      <div>
        <address class="address" style="margin:18px 0 20px">
          <strong>{yritys.nimi}</strong><br />
          {yritys.katuosoite}<br />
          {yritys.postinumero} {yritys.kaupunki}
        </address>
        <a class="button button-outline" href={yritys.karttalinkki} target="_blank" rel="noopener" style="margin-bottom:32px">Avaa kartalla <Ikoni nimi="sijainti" /></a>
        <div class="contact-map">
          <img src="/pirkanmaa.svg" alt="Kartta Pirkanmaan alueesta, Kangasala on merkitty kartalle" width="800" height="740" loading="lazy" />
          <small>Aluerajat: © EuroGeographics / Eurostat, GISCO</small>
        </div>
      </div>
    </div>
  </section>
</Sivupohja>
